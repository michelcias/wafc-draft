}

% Copiada do WALL (references_theo_1.bib), com uma correção: a entrada de lá
% traz `publisher = {Cambridge University Press}, address = {Cambridge}`, e
% isso não se confirma. O livro não tem registro no Crossref, e a busca em
% livros da Cambridge University Press por "Gaussian estimation" Johnstone
% devolveu zero resultados em 2026-09-19. A fonte oficial é a página do
% autor (https://imjohnstone.su.domains/), que oferece "Book Draft, version
% of September 16, 2019"; a folha de rosto do PDF diz "Draft version,
% September 16, 2019" e não nomeia editora. Por isso o tipo é
% `unpublished`, com a data da versão na `note`. Se o livro sair, a entrada
% troca de tipo. (Um "arroba" em comentário quebra o BibTeX, que não lê `%`
% como comentário fora de uma entrada; por isso os tipos aparecem aqui em
% crase, sem o prefixo.)
% Lido em 2026-10-01 no PDF da versão de 16 de setembro de 2019
% (refs/johnstone2019.pdf), a mesma da `note`. O que o projeto usa:
% Proposição 9.15 (§9.7, p. 273), b^α_{p,q} ⊂ wℓ_{p_α} com p_α = 2/(2α+1)
% quando p > p_α, que é o Lema 9(i) de E1.6 (τ = (s+1/2)^{-1}, sob
% π(s+1/2) > 1); e Teorema 9.3 (§9.4, p. 260), o risco minimax sobre bolas
% weak-ℓ_p de R^n, entre a1·min(C², C^p ε^{2−p}, nε²) e (2 log n + 1) vezes
% o mesmo controle, este atingido pela limiarização em sqrt(2 log n).
@unpublished{johnstone2019gaussian,
  title  = {Gaussian Estimation: Sequence and Wavelet Models},
  author = {Johnstone, Iain M.},
  year   = {2019},
  note   = {Draft version of September 16, 2019},
  url    = {https://imjohnstone.su.domains/GE_09_16_19.pdf}
}

